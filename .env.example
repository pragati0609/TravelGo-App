# Flask Settings
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=travelgo-super-secure-production-key-change-me

# AWS Configuration
# Note: When running on EC2 with IAM Role attached, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty.
# Boto3 will automatically use IAM Instance Profile credentials.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Tables
DYNAMODB_USERS_TABLE=TravelGo_Users
DYNAMODB_BOOKINGS_TABLE=TravelGo_Bookings

# Amazon SNS
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:BookingConfirmation

# Local Development / Mock Mode
# Set to 'true' to run fully offline using moto or in-memory fallback without active AWS charges
USE_MOCK_AWS=false
